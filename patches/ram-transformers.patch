+def _resolve_local_hf_snapshot(model_name: str):
+    hf_home = Path(os.environ.get("HF_HOME", Path.home() / ".cache" / "huggingface"))
+    hub_dir = hf_home / "hub" / f"models--{model_name.replace('/', '--')}"
+    ref_path = hub_dir / "refs" / "main"
+    if not ref_path.is_file():
+        return None
+    try:
+        revision = ref_path.read_text(encoding="utf-8").strip()
+    except OSError:
+        return None
+    if not revision:
+        return None
+    snapshot_dir = hub_dir / "snapshots" / revision
+    if not snapshot_dir.is_dir():
+        return None
+    required_names = ("tokenizer_config.json", "tokenizer.json", "vocab.txt")
+    if not all((snapshot_dir / name).exists() for name in required_names):
+        return None
+    return str(snapshot_dir)
+
