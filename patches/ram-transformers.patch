+def _align_label_embed(model, state_dict):
+    """确保 checkpoint 中的 label_embed 形状与当前模型一致。"""
+    label_key = 'label_embed'
+    if label_key not in state_dict:
+        return
+    model_state = model.state_dict()
+    if label_key not in model_state:
+        return
+    expected_shape = model_state[label_key].shape
+    current_shape = state_dict[label_key].shape
+    if current_shape == expected_shape:
+        return
+
+    print(f"调整 label_embed 形状: checkpoint {current_shape} -> model {expected_shape}")
+    new_weights = model_state[label_key].clone()
+    rows = min(expected_shape[0], current_shape[0])
+    new_weights[:rows] = state_dict[label_key][:rows]
+    state_dict[label_key] = new_weights
+
